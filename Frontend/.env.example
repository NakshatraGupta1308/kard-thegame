# Base URL of the KARD backend (Spring Boot server), without a trailing slash.
# The WebSocket endpoint is served at <VITE_BACKEND_URL>/ws.
# If unset, the app falls back to the local backend at http://localhost:8080.
# Copy this file to .env.local for local overrides, and set the variable in
# your hosting provider (for example Vercel) for production builds.
VITE_BACKEND_URL=https://uno-multiplayer-backend.onrender.com
